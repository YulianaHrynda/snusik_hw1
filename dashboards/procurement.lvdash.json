{
  "datasets": [
    {
      "name": "headline",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT\n",
        "  (SELECT round(100 * sum(inventory_value) / max(total_inventory_value), 2)\n",
        "     FROM supplier_inventory WHERE rank <= 10)                          AS top10_inventory_pct,\n",
        "  (SELECT round(100 * avg(top10_share), 2)\n",
        "     FROM monitor_spend_concentration)                                  AS avg_top10_spend_pct,\n",
        "  (SELECT count_if(is_single_sourced) FROM part_sourcing)               AS single_sourced_parts,\n",
        "  (SELECT round(100 * sum(CASE WHEN has_complaint THEN spend ELSE 0 END) / sum(spend), 3)\n",
        "     FROM supplier_complaints)                                          AS complaint_spend_pct"
      ]
    },
    {
      "name": "q1_top10",
      "displayName": "Q1 top-ten inventory",
      "queryLines": [
        "SELECT rank, supplier_name, nation, region,\n",
        "       round(inventory_value / 1e6, 2) AS inventory_value_m,\n",
        "       round(100 * inventory_share, 3) AS inventory_pct\n",
        "FROM supplier_inventory WHERE rank <= 10"
      ]
    },
    {
      "name": "q2_gaps",
      "displayName": "Q2 Brand#32 largest price gaps",
      "queryLines": [
        "SELECT concat('Part ', part_key) AS part, cheapest_cost, most_expensive_cost, cost_gap,\n",
        "       round(100 * cost_gap_share, 1) AS cost_gap_pct\n",
        "FROM brand32_sourcing ORDER BY cost_gap DESC, part_key LIMIT 15"
      ]
    },
    {
      "name": "q2_status",
      "displayName": "Q2 Brand#32 sourcing status",
      "queryLines": [
        "SELECT sourcing_status, count(*) AS parts FROM brand32_sourcing GROUP BY sourcing_status"
      ]
    },
    {
      "name": "q3_distribution",
      "displayName": "Q3 suppliers used per part",
      "queryLines": [
        "SELECT CAST(ordered_supplier_count AS STRING) AS suppliers_used, count(*) AS parts\n",
        "FROM part_sourcing GROUP BY ordered_supplier_count"
      ]
    },
    {
      "name": "q3_by_region",
      "displayName": "Q3 single-sourced parts by region",
      "queryLines": [
        "SELECT sole_supplier_region AS region, count(*) AS single_sourced_parts,\n",
        "       round(sum(spend) / 1e6, 3) AS spend_m\n",
        "FROM part_sourcing WHERE is_single_sourced GROUP BY sole_supplier_region"
      ]
    },
    {
      "name": "q4_suppliers",
      "displayName": "Q4 suppliers with complaints",
      "queryLines": [
        "SELECT supplier_name, nation, region, round(spend / 1e6, 3) AS spend_m,\n",
        "       round(100 * spend_share, 4) AS spend_pct, supplier_comment\n",
        "FROM supplier_complaints WHERE has_complaint ORDER BY spend DESC"
      ]
    },
    {
      "name": "q4_trend",
      "displayName": "Q4 complaint spend share by month",
      "queryLines": [
        "SELECT m.period,\n",
        "       round(100 * sum(CASE WHEN c.has_complaint THEN m.spend ELSE 0 END) / sum(m.spend), 4)\n",
        "           AS complaint_spend_pct\n",
        "FROM supplier_spend_monthly m JOIN supplier_complaints c USING (supplier_key)\n",
        "GROUP BY m.period"
      ]
    },
    {
      "name": "mon_concentration",
      "displayName": "Monitoring spend concentration",
      "queryLines": [
        "SELECT period, round(100 * top10_share, 3) AS top10_spend_pct FROM monitor_spend_concentration"
      ]
    },
    {
      "name": "mon_region_cost",
      "displayName": "Monitoring supply cost by region",
      "queryLines": [
        "SELECT period, region, avg_supply_cost_per_unit FROM monitor_supply_cost_by_region"
      ]
    },
    {
      "name": "mon_largest_supplier",
      "displayName": "Monitoring largest single-supplier share",
      "queryLines": [
        "SELECT period, round(100 * max(spend) / sum(spend), 3) AS largest_supplier_pct\n",
        "FROM supplier_spend_monthly GROUP BY period"
      ]
    }
  ],
